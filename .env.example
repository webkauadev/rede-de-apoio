# Opcional para o scaffold. Configure somente em ambiente de banco autorizado.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Reservado para as US de identidade; ainda não consumido.
SESSION_SECRET=

# Origem pública do app para checagem same-origin; ajuste ao endereço utilizado.
APPLICATION_ORIGIN=http://localhost:3000

# Cadastro permanece fechado fora do ensaio local descartavel autorizado.
# Use scripts/mysql-disposable.mjs; nao copie credenciais/segredos para este arquivo.
REGISTRATION_ENVIRONMENT=
